# Serves the built frontend and reverse-proxies the API (and the screen-mirror
# WebSocket) to the Pi backend. ${PI_HOST} is substituted at container start
# (nginx only substitutes env vars, so the $nginx_variables below are preserved).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       80;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # Everything under /api goes to the Pi (JSON, image previews, and the
    # /api/stream/ws mirror WebSocket — hence the Upgrade headers).
    # PI_SCHEME is http by default; set it to https when the Pi serves TLS
    # (deploy/enable-https.sh). proxy_ssl_verify is off because the Pi uses a
    # self-signed / locally-trusted cert the container has no reason to validate.
    location /api/ {
        proxy_pass            ${PI_SCHEME}://${PI_HOST};
        proxy_ssl_verify      off;
        proxy_ssl_server_name on;
        proxy_http_version    1.1;
        proxy_set_header      Host              $host;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_set_header      Upgrade           $http_upgrade;
        proxy_set_header      Connection        $connection_upgrade;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        client_max_body_size  30m;   # matches the backend's upload cap
    }

    # SPA fallback for the static frontend.
    location / {
        try_files $uri /index.html;
    }
}
