# Python
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/

# Secrets / local config — never commit these
.env
*.env
!*.env.example
backend/.env
backend/.env.local

# Backend data (uploaded media + library index)
backend/data/

# Node / frontend build output
node_modules/
frontend/dist/
frontend/.vite/

# Browser extension build output (assembled by extension/build.*)
extension/build/

# TLS certificates / private keys (generated by deploy/enable-https.sh)
backend/certs/
*.pem
*.key
*.crt

# Split-deployment marker (this Pi runs backend-only; UI hosted elsewhere)
.backend-only

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# AI assistant tooling — local design skill + hooks, not part of the app.
# (DESIGN.md and the tracked .impeccable/{config,design}.json sidecar stay in.)
.agents/
.claude/
.codex/
.impeccable/critique/
