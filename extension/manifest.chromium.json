{
  "manifest_version": 3,
  "name": "Pixel Pusher Now Playing",
  "version": "1.0.0",
  "description": "Sends whatever is playing in your browser (any tab) to your Pixel Pusher LED panel.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["inject.js"], "matches": ["<all_urls>"] }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixel Pusher Now Playing"
  }
}
