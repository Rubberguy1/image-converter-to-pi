[Unit]
Description=Pixel Pusher - LED matrix controller
After=network-online.target
Wants=network-online.target

[Service]
# The matrix library needs root for stable GPIO timing.
User=root
# Adjust this path if you cloned somewhere other than /home/pi/pixel-pusher.
WorkingDirectory=/home/pi/pixel-pusher/backend
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/pi/pixel-pusher/backend/.env
# `python -m app` runs uvicorn and adds TLS automatically when TLS_CERTFILE /
# TLS_KEYFILE are set in .env (see docs/HTTPS.md). Plain HTTP otherwise.
ExecStart=/home/pi/pixel-pusher/backend/.venv/bin/python -m app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
